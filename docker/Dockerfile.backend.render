# NEXUS ATLAS — Render-optimized image (fits free tier build limits)
# Single stage, slim base, lightweight deps.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000

# Minimal runtime libs — no GDAL, no OpenCV native deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install lean requirements
COPY backend/requirements-render.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy source
COPY backend/ /app/backend/
COPY geospatial/ /app/geospatial/
COPY ai_models/ /app/ai_models/
COPY scripts/ /app/scripts/

RUN mkdir -p /app/scans /app/reports /app/logs

WORKDIR /app/backend
ENV PYTHONPATH=/app/backend:/app/geospatial:/app/ai_models

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:${PORT}/health || exit 1

EXPOSE 8000

# Single worker for free tier (limited RAM)
CMD ["sh", "-c", "gunicorn app.main:app -w 1 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:${PORT} --access-logfile - --error-logfile - --timeout 180"]
